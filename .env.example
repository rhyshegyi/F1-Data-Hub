# Databricks Free Edition connection for dbt and the ingestion scripts.
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# dbt auto-loads this file from the project directory, so once it is filled in
# you can run `uv run dbt debug` from the repo root with no flags and no
# shell setup.
#
# IMPORTANT: leave the three credential lines below COMMENTED OUT until you
# have real values. An empty assignment (`DATABRICKS_TOKEN=`) sets the variable
# to an empty string rather than leaving it unset, which defeats the fallback
# defaults in dbt_project/profiles.yml -- dbt then reports a confusing
# "cannot configure default credentials / auth_type=external-browser" error
# instead of simply using the offline placeholders.

# Workspace hostname, no scheme and no trailing slash.
# Databricks UI -> SQL Warehouses -> <warehouse> -> Connection details.
# Example: dbc-1234abcd-5678.cloud.databricks.com
# DATABRICKS_HOST=

# SQL warehouse HTTP path, from the same Connection details tab.
# Example: /sql/1.0/warehouses/abc123def456
# DATABRICKS_HTTP_PATH=

# Personal access token.
# Databricks UI -> Settings -> Developer -> Access tokens -> Generate new token.
# DATABRICKS_TOKEN=

# --- Non-secret settings (safe to leave active) ----------------------

# Unity Catalog catalog. Free Edition workspaces default to `workspace`.
DATABRICKS_CATALOG=workspace

# Schema dbt builds into. Layer suffixes are applied on top of this
# (e.g. f1_staging, f1_intermediate, f1_marts).
DATABRICKS_SCHEMA=f1

# Schema the ingestion scripts land raw Jolpica pages into.
DATABRICKS_RAW_SCHEMA=f1_raw

# --- dbt convenience -------------------------------------------------
# With these set, dbt commands work from the repo root with no
# --project-dir / --profiles-dir flags.
DBT_PROJECT_DIR=dbt_project
DBT_PROFILES_DIR=dbt_project
